{
    "name": "mgiannopoulos24/cf7-live-preview",
    "description": "Preview a Contact Form 7 form and its email from the editor, with your theme's styles and without saving.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Marios Giannopoulos",
            "email": "mariosgian_2002@yahoo.gr",
            "homepage": "https://github.com/mgiannopoulos24"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.11",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
